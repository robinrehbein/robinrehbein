{
  "name": "@robinrehbein/home",
  "version": "1.0.0",
  "exports": "./main.ts",
  "tasks": {
    "check": "deno fmt --check main.ts client.ts utils.ts vite.config.ts deno.json routes components lib && deno lint main.ts client.ts utils.ts vite.config.ts routes components lib && deno check main.ts client.ts utils.ts vite.config.ts routes/**/*.tsx components/**/*.tsx lib/**/*.ts",
    "dev": "deno run -A vite --host",
    "build": "deno run -A vite build",
    "start": "deno serve -A _fresh/server.js"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    ".vite/**",
    ".kilocode/**",
    ".claude/**",
    "node_modules/**"
  ],
  "imports": {
    "fresh": "jsr:@fresh/core@^2.2.0",
    "fresh/": "jsr:@fresh/core@^2.2.0/",
    "fresh/runtime": "jsr:@fresh/core@^2.2.0/runtime",
    "fresh/runtime-client": "jsr:@fresh/core@^2.2.0/runtime-client",
    "fresh/internal": "jsr:@fresh/core@^2.2.0/internal",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "preact": "npm:preact@^10.27.2",
    "preact/": "npm:preact@^10.27.2/",
    "preact/jsx-runtime": "npm:preact@^10.27.2/jsx-runtime",
    "preact/jsx-dev-runtime": "npm:preact@^10.27.2/jsx-dev-runtime",
    "preact/hooks": "npm:preact@^10.27.2/hooks",
    "@preact/signals": "npm:@preact/signals@^2.5.0",
    "vite": "npm:vite@^7.1.3",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@/": "./"
  },
  "compilerOptions": {
    "lib": [
      "deno.unstable",
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "nodeModulesDir": "auto"
}
